DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketing_saas?sslmode=disable
PORT=8081
LOG_LEVEL=debug
SECRET_KEY=your-256-bit-secret-key-here-use-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
GO_API_URL=http://localhost:8080
GRPC_SERVER_URL=localhost:9090
JWT_SECRET=your-256-bit-secret-key-here-use-at-least-32-chars

# Email Configuration
EMAIL_PROVIDER=stub
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=Marketing SaaS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Social Media Publishing (Facebook/Instagram)
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# SEO Data Sources
# Google Search Console (requires service account credentials JSON)
GSC_CREDENTIALS_PATH=/path/to/credentials.json
GSC_SITE_URL=sc-domain:yourdomain.com

# Ahrefs API (https://ahrefs.com/api)
AHREFS_API_TOKEN=your-ahrefs-api-token

# SEMrush API (https://www.semrush.com/api/)
SEMRUSH_API_KEY=your-semrush-api-key
