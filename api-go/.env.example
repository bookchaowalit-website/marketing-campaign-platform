PORT=8080
GRPC_PORT=9090
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketing_saas?sslmode=disable
PYTHON_API_URL=http://localhost:8081
JWT_SECRET=your-256-bit-secret-key-here-use-at-least-32-chars
LOG_LEVEL=debug
FRONTEND_URL=http://localhost:3000

# Email Configuration
# Options: stub (development), sendgrid, ses
EMAIL_PROVIDER=stub

# SendGrid (required if EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=Marketing SaaS

# AWS SES (required if EMAIL_PROVIDER=ses)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Social Media Publishing (Facebook/Instagram)
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Social Media - TikTok
TIKTOK_CLIENT_ID=your-tiktok-client-id
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_REDIRECT_URL=http://localhost:3000/settings/social/callback?platform=tiktok

# Social Media - Twitter/X
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# Social Media - LinkedIn
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# SMS Marketing - Twilio (required for SMS sending)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# PPC/Paid Ads - Google Ads
GOOGLE_ADS_CLIENT_ID=your-google-ads-client-id
GOOGLE_ADS_CLIENT_SECRET=your-google-ads-client-secret
GOOGLE_ADS_DEVELOPER_TOKEN=your-google-ads-developer-token

# PPC/Paid Ads - Facebook Ads
FACEBOOK_ADS_APP_ID=your-facebook-ads-app-id
FACEBOOK_ADS_APP_SECRET=your-facebook-ads-app-secret
